#version 460

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D u_HDRInput;
layout(set = 0, binding = 1, rgba8) writeonly uniform image2D u_LDROutput;

layout(push_constant) uniform PushConstants {
    float exposure;
} pc;

void main() {
    ivec2 size = imageSize(u_LDROutput);
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= size.x || pos.y >= size.y)
        return;

    vec3 color = texelFetch(u_HDRInput, pos, 0).rgb;

    // Exposure tonemap only (matching old OpenGL HDR pass exactly)
    color = vec3(1.0) - exp(-color * pc.exposure);

    imageStore(u_LDROutput, pos, vec4(color, 1.0));
}
